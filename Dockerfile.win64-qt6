# syntax=docker/dockerfile:1
# ============================================================================
# Dockerfile.win64-qt6 — modbus-client, Qt6, Windows x64 (MinGW cross)
#
# Build:
#   docker buildx build -f Dockerfile.win64-qt6 --target export \
#       --output type=local,dest=out/win-qt6 \
#       --build-arg BASE_DEPS_IMAGE=base-deps-win64-qt6:latest \
#       .
# ============================================================================
ARG BASE_DEPS_IMAGE=base-deps-win64-qt6:latest

FROM ${BASE_DEPS_IMAGE} AS build

ARG CORE_SDK_VERSION=1.1.0
ARG CORE_SDK_URL=
ARG CORE_SDK_PLATFORM=win64
ARG QT_VERSION_MAJOR=6
ARG QT6_INSTALL_PREFIX=/opt/Qt/6.8.0/mingw_64
ARG QT_HOST_PATH=/opt/Qt/6.8.0/gcc_64
ARG CMAKE_TOOLCHAIN_FILE=/opt/x86_64-w64-mingw32.cmake
ARG CORE_INSTALL_BASE=/opt/modbus-client
ARG BUILD_TYPE=Release

# fetch-core-sdk.sh читает CORE_SDK_PLATFORM из env → win64.zip
ENV CORE_SDK_PLATFORM=${CORE_SDK_PLATFORM} \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# 1) Core SDK: win64 .zip → unzip/7z (fetch-core-sdk.sh сам выберет)
COPY scripts/fetch-core-sdk.sh /usr/local/bin/fetch-core-sdk.sh
RUN chmod +x /usr/local/bin/fetch-core-sdk.sh && \
    fetch-core-sdk.sh "${CORE_SDK_VERSION}" "${CORE_SDK_URL}" \
        "/opt/core/qt${QT_VERSION_MAJOR}/${CORE_SDK_VERSION}" \
        "${QT_VERSION_MAJOR}" && \
    ln -sfn "/opt/core/qt${QT_VERSION_MAJOR}/${CORE_SDK_VERSION}" \
            "/opt/core/qt${QT_VERSION_MAJOR}/latest" && \
    test -f "/opt/core/qt${QT_VERSION_MAJOR}/latest/lib/cmake/Core/CoreConfig.cmake" && \
    echo "=== Core SDK win64 / Qt${QT_VERSION_MAJOR} ready ==="

# 2) Сборка modbus-client (кросс)
WORKDIR /app
COPY . /app/modbus-client/
WORKDIR /app/modbus-client

RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    echo "=== modbus-client v${V} (Qt${QT_VERSION_MAJOR} win64) ==="; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    CORE_SDK="/opt/core/qt${QT_VERSION_MAJOR}/latest"; \
    mkdir -p "${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}"; \
    cmake -S . -B build \
        -DCMAKE_TOOLCHAIN_FILE="${CMAKE_TOOLCHAIN_FILE}" \
        -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
        -DQT_VERSION_MAJOR="${QT_VERSION_MAJOR}" \
        -DCore_DIR="${CORE_SDK}/lib/cmake/Core" \
        -DCMAKE_INSTALL_PREFIX="${DEST}" \
        -DQT_HOST_PATH="${QT_HOST_PATH}" \
        -DMODBUS_CLIENT_DEPLOY=OFF; \
    cmake --build build -j"$(nproc)"; \
    cmake --install build; \
    # Sanity: exe должен был создаться.
    test -f "${DEST}/bin/modbus-client.exe" \
        || { echo "FATAL: ${DEST}/bin/modbus-client.exe missing" >&2; \
             find "${DEST}" -maxdepth 3 -type d 2>/dev/null >&2 || true; \
             find "${DEST}" -maxdepth 3 -type f 2>/dev/null >&2 || true; \
             exit 1; }; \
    ln -sfn "${DEST}" "${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/latest"; \
    # ── Бандлим Core SDK: include + libs(.dll в bin, .dll.a в lib) + cmake ──
    mkdir -p "${DEST}/lib" "${DEST}/include" "${DEST}/bin"; \
    cp -a "${CORE_SDK}/include/." "${DEST}/include/"; \
    cp -a "${CORE_SDK}/lib/"libcore-*.dll.a       "${DEST}/lib/" 2>/dev/null || true; \
    cp -a "${CORE_SDK}/lib/"libqcustomplot*.dll.a "${DEST}/lib/" 2>/dev/null || true; \
    cp -a "${CORE_SDK}/lib/"libQtWebApp*.dll.a    "${DEST}/lib/" 2>/dev/null || true; \
    cp -a "${CORE_SDK}/bin/"libcore-*.dll         "${DEST}/bin/" 2>/dev/null || true; \
    cp -a "${CORE_SDK}/bin/"libqcustomplot*.dll   "${DEST}/bin/" 2>/dev/null || true; \
    cp -a "${CORE_SDK}/bin/"libQtWebApp*.dll      "${DEST}/bin/" 2>/dev/null || true; \
    mkdir -p "${DEST}/lib/cmake"; \
    cp -a "${CORE_SDK}/lib/cmake/." "${DEST}/lib/cmake/"; \
    # ── Qt6 target DLL (все, включая транзитивные: Ssl, Crypto, zstd, …) ──
    cp -a "${QT6_INSTALL_PREFIX}/bin/"Qt6*.dll        "${DEST}/bin/"; \
    cp -a "${QT6_INSTALL_PREFIX}/bin/"libssl*.dll     "${DEST}/bin/" 2>/dev/null || true; \
    cp -a "${QT6_INSTALL_PREFIX}/bin/"libcrypto*.dll  "${DEST}/bin/" 2>/dev/null || true; \
    cp -a "${QT6_INSTALL_PREFIX}/bin/"libzstd*.dll    "${DEST}/bin/" 2>/dev/null || true; \
    # ── MinGW runtime (libstdc++-6.dll, libgcc_s_seh-1.dll, libwinpthread-1.dll) ──
    for dll in libstdc++-6.dll libgcc_s_seh-1.dll libwinpthread-1.dll libssp-0.dll; do \
        found="$(find /usr/x86_64-w64-mingw32/bin /usr/lib/gcc/x86_64-w64-mingw32 \
                       -name "$dll" -type f 2>/dev/null | head -1)"; \
        if [ -n "$found" ]; then \
            cp -a "$found" "${DEST}/bin/"; \
        else \
            echo "WARN: $dll not found (may be not required)" >&2; \
        fi; \
    done; \
    # ── Qt6 plugins ──
    for plugin_dir in platforms imageformats iconengines styles sqldrivers tls bearer; do \
        if [ -d "${QT6_INSTALL_PREFIX}/plugins/${plugin_dir}" ]; then \
            mkdir -p "${DEST}/plugins"; \
            cp -a "${QT6_INSTALL_PREFIX}/plugins/${plugin_dir}" "${DEST}/plugins/"; \
        fi; \
    done; \
    echo "=== install layout ==="; \
    find "${DEST}" -maxdepth 2 -type d | sort; \
    echo "--- bin/ (head) ---"; \
    ls "${DEST}/bin/" | head -30; \
    echo "--- plugins/ ---"; \
    find "${DEST}/plugins" -maxdepth 2 -type d | sort; \
    test -f "${DEST}/lib/cmake/Core/CoreConfig.cmake" \
        || { echo "FATAL: bundled CoreConfig.cmake missing" >&2; exit 1; }; \
    test -f "${DEST}/bin/Qt6Core.dll" \
        || { echo "FATAL: Qt6Core.dll missing" >&2; exit 1; }; \
    test -f "${DEST}/plugins/platforms/qwindows.dll" \
        || { echo "FATAL: qwindows.dll platform plugin missing" >&2; \
             ls "${DEST}/plugins/platforms/" >&2 || true; exit 1; }

# 3) Export: только содержимое install/latest/
FROM scratch AS export
ARG QT_VERSION_MAJOR=6
ARG CORE_INSTALL_BASE=/opt/modbus-client
COPY --from=build ${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/latest/ /

FROM build AS final