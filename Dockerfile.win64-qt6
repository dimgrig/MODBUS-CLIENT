# syntax=docker/dockerfile:1
# ============================================================================
# Dockerfile.win64-qt6 — modbus-client, Qt6, Windows x64 (MinGW cross)
#
# Build:
#   docker buildx build -f Dockerfile.win64-qt6 --target export \
#       --output type=local,dest=out/win-qt6 \
#       --build-arg BASE_DEPS_IMAGE=base-deps-win64-qt6:latest \
#       .
# ============================================================================
ARG BASE_DEPS_IMAGE=base-deps-win64-qt6:latest

FROM ${BASE_DEPS_IMAGE} AS build

ARG CORE_SDK_VERSION=1.1.0
ARG CORE_SDK_URL=
ARG CORE_SDK_PLATFORM=win64
ARG QT_VERSION_MAJOR=6
ARG QT6_INSTALL_PREFIX=/opt/Qt/6.8.0/mingw_64
ARG QT_HOST_PATH=/opt/Qt/6.8.0/gcc_64
ARG CMAKE_TOOLCHAIN_FILE=/opt/x86_64-w64-mingw32.cmake
ARG CORE_INSTALL_BASE=/opt/modbus-client
ARG BUILD_TYPE=Release

ENV CORE_SDK_PLATFORM=${CORE_SDK_PLATFORM} \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# ── 1) Core SDK ────────────────────────────────────────────────────────────
COPY scripts/fetch-core-sdk.sh /usr/local/bin/fetch-core-sdk.sh
RUN chmod +x /usr/local/bin/fetch-core-sdk.sh && \
    fetch-core-sdk.sh "${CORE_SDK_VERSION}" "${CORE_SDK_URL}" \
        "/opt/core/qt${QT_VERSION_MAJOR}/${CORE_SDK_VERSION}" \
        "${QT_VERSION_MAJOR}" && \
    ln -sfn "/opt/core/qt${QT_VERSION_MAJOR}/${CORE_SDK_VERSION}" \
            "/opt/core/qt${QT_VERSION_MAJOR}/latest" && \
    test -f "/opt/core/qt${QT_VERSION_MAJOR}/latest/lib/cmake/Core/CoreConfig.cmake" && \
    echo "=== Core SDK win64 / Qt${QT_VERSION_MAJOR} ready ==="

# ── 2) Сборка modbus-client (кросс) ────────────────────────────────────────
WORKDIR /app
COPY . /app/modbus-client/
WORKDIR /app/modbus-client

# 2a) configure + build + install
RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    echo "=== modbus-client v${V} (Qt${QT_VERSION_MAJOR} win64) ==="; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    CORE_SDK="/opt/core/qt${QT_VERSION_MAJOR}/latest"; \
    mkdir -p "${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}"; \
    cmake -S . -B build \
        -DCMAKE_TOOLCHAIN_FILE="${CMAKE_TOOLCHAIN_FILE}" \
        -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
        -DQT_VERSION_MAJOR="${QT_VERSION_MAJOR}" \
        -DCore_DIR="${CORE_SDK}/lib/cmake/Core" \
        -DCMAKE_INSTALL_PREFIX="${DEST}" \
        -DQT_HOST_PATH="${QT_HOST_PATH}" \
        -DMODBUS_CLIENT_DEPLOY=OFF; \
    cmake --build build -j"$(nproc)"; \
    cmake --install build; \
    test -f "${DEST}/bin/modbus-client.exe" \
        || { echo "FATAL: modbus-client.exe missing" >&2; exit 1; }; \
    ln -sfn "${DEST}" "${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/latest"

# 2b) Core DLLs — только те, с которыми линкуется exe
RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    CORE_SDK="/opt/core/qt${QT_VERSION_MAJOR}/latest"; \
    mkdir -p "${DEST}/bin"; \
    for lib in libcore-lib libcore-journal-lib libcore-modbus-lib libcore-widgets-lib; do \
        cp -a "${CORE_SDK}/bin/${lib}.dll" "${DEST}/bin/"; \
    done; \
    echo "Core DLLs copied to ${DEST}/bin/"

# 2c) Qt6 DLLs (все, что есть в prefix — урезание будет на этапе 2.12)
RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    cp -a "${QT6_INSTALL_PREFIX}/bin/"Qt6*.dll        "${DEST}/bin/"; \
    cp -a "${QT6_INSTALL_PREFIX}/bin/"libssl*.dll     "${DEST}/bin/" 2>/dev/null || true; \
    cp -a "${QT6_INSTALL_PREFIX}/bin/"libcrypto*.dll  "${DEST}/bin/" 2>/dev/null || true; \
    cp -a "${QT6_INSTALL_PREFIX}/bin/"libzstd*.dll    "${DEST}/bin/" 2>/dev/null || true; \
    echo "Qt6 DLLs copied to ${DEST}/bin/"

# 2d) MinGW runtime (64-bit): обязательный набор
#     ВАЖНО: libwinpthread-1.dll ранее пропускалась из-за бага find|head-1
#     (мог подхватить 32-битную копию) → 0xc000007b. Явные пути + проверка.
RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    for dll in libgcc_s_seh-1.dll libstdc++-6.dll libwinpthread-1.dll libssp-0.dll libatomic-1.dll; do \
        src=""; \
        for cand in \
            "/usr/lib/gcc/x86_64-w64-mingw32/13-posix/$dll" \
            "/usr/lib/gcc/x86_64-w64-mingw32/12-posix/$dll" \
            "/usr/lib/gcc/x86_64-w64-mingw32/13-win32/$dll" \
            "/usr/lib/gcc/x86_64-w64-mingw32/12-win32/$dll" \
            "/usr/x86_64-w64-mingw32/bin/$dll" \
            "/usr/x86_64-w64-mingw32/lib/$dll" \
            "/usr/x86_64-w64-mingw32/lib64/$dll"; do \
            if [ -f "$cand" ]; then src="$cand"; break; fi; \
        done; \
        if [ -z "$src" ]; then \
            if [ "$dll" = "libatomic-1.dll" ]; then \
                echo "NOTE: $dll not found (optional)"; \
                continue; \
            fi; \
            echo "FATAL: 64-bit $dll not found" >&2; \
            exit 1; \
        fi; \
        if ! x86_64-w64-mingw32-objdump -f "$src" 2>/dev/null | grep -q 'pei-x86-64'; then \
            echo "FATAL: $src is not 64-bit (pei-x86-64)" >&2; \
            x86_64-w64-mingw32-objdump -f "$src" >&2; \
            exit 1; \
        fi; \
        cp -a "$src" "${DEST}/bin/"; \
        echo "MinGW runtime (64-bit): $src"; \
    done

# 2e) Qt6 plugins
RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    for plugin_dir in platforms imageformats iconengines styles sqldrivers tls bearer; do \
        if [ -d "${QT6_INSTALL_PREFIX}/plugins/${plugin_dir}" ]; then \
            cp -a "${QT6_INSTALL_PREFIX}/plugins/${plugin_dir}" "${DEST}/bin/"; \
        fi; \
    done

# 2f) Финальная проверка layout
RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    echo "=== install layout ==="; \
    find "${DEST}" -maxdepth 2 -type d | sort; \
    echo "--- bin/ (head) ---"; \
    ls "${DEST}/bin/" | head -30; \
    echo "--- plugins/ ---"; \
    for d in platforms imageformats iconengines styles sqldrivers tls bearer; do \
        [ -d "${DEST}/bin/$d" ] && echo "  bin/$d/"; \
    done; \
    for lib in libcore-lib libcore-journal-lib libcore-modbus-lib libcore-widgets-lib; do \
        test -f "${DEST}/bin/${lib}.dll" \
            || { echo "FATAL: ${lib}.dll missing" >&2; ls "${DEST}/bin/" >&2; exit 1; }; \
    done; \
    test -f "${DEST}/bin/Qt6Core.dll" \
        || { echo "FATAL: Qt6Core.dll missing" >&2; exit 1; }; \
    test -f "${DEST}/bin/platforms/qwindows.dll" \
        || { echo "FATAL: platforms/qwindows.dll missing in bin/" >&2; \
             ls "${DEST}/bin/platforms/" >&2 || true; exit 1; }; \
    for dll in libgcc_s_seh-1.dll libstdc++-6.dll libwinpthread-1.dll; do \
        test -f "${DEST}/bin/$dll" \
            || { echo "FATAL: mandatory $dll missing in bundle" >&2; exit 1; }; \
    done; \
    echo "=== OK: modbus-client win-qt6 bundle ready ==="

# ── 3) Export ──────────────────────────────────────────────────────────────
FROM scratch AS export
ARG QT_VERSION_MAJOR=6
ARG CORE_INSTALL_BASE=/opt/modbus-client
COPY --from=build ${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/latest/ /

FROM build AS final