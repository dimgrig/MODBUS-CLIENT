# syntax=docker/dockerfile:1
# ============================================================================
# Dockerfile.linux-qt6 — modbus-client, Qt6, Linux amd64
#
# Build:
#   docker buildx build -f Dockerfile.linux-qt6 --target export \
#       --output type=local,dest=out/linux-qt6 \
#       --build-arg BASE_DEPS_IMAGE=base-deps-linux-qt6:latest \
#       .
# ============================================================================
ARG BASE_DEPS_IMAGE=base-deps-linux-qt6:latest

FROM ${BASE_DEPS_IMAGE} AS build

ARG CORE_SDK_VERSION=1.1.0
ARG CORE_SDK_URL=
ARG QT_VERSION_MAJOR=6
ARG QT6_INSTALL_PREFIX=/opt/Qt/6.8.0/gcc_64
ARG CORE_INSTALL_BASE=/opt/modbus-client
ARG CMAKE_TOOLCHAIN_FILE=
ARG BUILD_TYPE=Release

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    QT_QPA_PLATFORM=offscreen

# 1) Core SDK: fetch-core-sdk.sh идемпотентен (no-op, если уже в образе)
COPY scripts/fetch-core-sdk.sh /usr/local/bin/fetch-core-sdk.sh
RUN chmod +x /usr/local/bin/fetch-core-sdk.sh && \
    fetch-core-sdk.sh "${CORE_SDK_VERSION}" "${CORE_SDK_URL}" \
        "/opt/core/qt${QT_VERSION_MAJOR}/${CORE_SDK_VERSION}" \
        "${QT_VERSION_MAJOR}" && \
    ln -sfn "/opt/core/qt${QT_VERSION_MAJOR}/${CORE_SDK_VERSION}" \
            "/opt/core/qt${QT_VERSION_MAJOR}/latest" && \
    test -f "/opt/core/qt${QT_VERSION_MAJOR}/latest/lib/cmake/Core/CoreConfig.cmake"

# 2) Сборка modbus-client
WORKDIR /app
COPY . /app/modbus-client/
WORKDIR /app/modbus-client

RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    echo "=== modbus-client v${V} (Qt${QT_VERSION_MAJOR}) ==="; \
    CMAKE_PREFIX_ARG=""; \
    if [ "${QT_VERSION_MAJOR}" = "6" ] && [ -n "${QT6_INSTALL_PREFIX}" ]; then \
        CMAKE_PREFIX_ARG="-DCMAKE_PREFIX_PATH=${QT6_INSTALL_PREFIX}"; \
    fi; \
    CMAKE_TOOLCHAIN_ARG=""; \
    if [ -n "${CMAKE_TOOLCHAIN_FILE}" ]; then \
        CMAKE_TOOLCHAIN_ARG="-DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}"; \
    fi; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    CORE_SDK="/opt/core/qt${QT_VERSION_MAJOR}/latest"; \
    # Директория install-префикса — на случай, если install(TARGETS)
    # окажется пустым (defensive: не зависеть от порядка install()).
    mkdir -p "${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}"; \
    cmake -S . -B build \
        -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
        -DQT_VERSION_MAJOR="${QT_VERSION_MAJOR}" \
        -DCore_DIR="${CORE_SDK}/lib/cmake/Core" \
        -DCMAKE_INSTALL_PREFIX="${DEST}" \
        ${CMAKE_PREFIX_ARG} \
        ${CMAKE_TOOLCHAIN_ARG}; \
    cmake --build build -j"$(nproc)"; \
    cmake --install build; \
    # Sanity: install(TARGETS) должен был создать bin/modbus-client.
    test -x "${DEST}/bin/modbus-client" \
        || { echo "FATAL: ${DEST}/bin/modbus-client missing" >&2; \
             find "${DEST}" -maxdepth 3 -type d 2>/dev/null >&2 || true; \
             exit 1; }; \
    ln -sfn "${DEST}" "${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/latest"; \
    # ── Бандлим Core SDK целиком: include + libs + cmake-конфиги ──
    # install(TARGETS modbus-client RUNTIME DESTINATION bin) создаёт
    # только bin/ — lib/ и include/ добавляем руками.
    mkdir -p "${DEST}/lib" "${DEST}/include"; \
    cp -a "${CORE_SDK}/include/." "${DEST}/include/"; \
    cp -a "${CORE_SDK}/lib/"libcore-*.so*        "${DEST}/lib/"; \
    cp -a "${CORE_SDK}/lib/"libqcustomplot*.so*  "${DEST}/lib/" 2>/dev/null || true; \
    cp -a "${CORE_SDK}/lib/"libQtWebApp*.so*     "${DEST}/lib/" 2>/dev/null || true; \
    mkdir -p "${DEST}/lib/cmake"; \
    cp -a "${CORE_SDK}/lib/cmake/."              "${DEST}/lib/cmake/"; \
    echo "=== install layout ==="; \
    find "${DEST}" -maxdepth 3 -type d | sort; \
    ls -la "${DEST}/bin/"; \
    ls "${DEST}/lib/" | head -20; \
    test -f "${DEST}/lib/cmake/Core/CoreConfig.cmake" \
        || { echo "FATAL: bundled CoreConfig.cmake missing" >&2; exit 1; }

# 3) Smoke-test (offscreen) — паритет с CI job
FROM build AS test

RUN set -eux; \
    V="$(tr -d '[:space:]' < /app/modbus-client/VERSION)"; \
    QT_QPA_PLATFORM=offscreen MODBUS_SMOKE=1 \
        LD_LIBRARY_PATH="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}/lib:${QT6_INSTALL_PREFIX}/lib" \
        "${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}/bin/modbus-client"; \
    echo "=== smoke OK ==="

# 4) Export: только содержимое install/latest/
FROM scratch AS export
ARG QT_VERSION_MAJOR=6
ARG CORE_INSTALL_BASE=/opt/modbus-client
COPY --from=build ${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/latest/ /

FROM build AS final