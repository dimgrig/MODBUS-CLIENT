# syntax=docker/dockerfile:1
# ============================================================================
# Dockerfile.win — modbus-client, Qt5, Windows x32 (i686 MinGW cross, legacy)
#
# Build:
#   docker buildx build -f Dockerfile.win --target export \
#       --output type=local,dest=out/win-qt5 \
#       --build-arg BASE_DEPS_IMAGE=base-deps-win:latest \
#       .
# ============================================================================
ARG BASE_DEPS_IMAGE=base-deps-win:latest

FROM ${BASE_DEPS_IMAGE} AS build

ARG CORE_SDK_VERSION=1.1.0
ARG CORE_SDK_URL=
ARG CORE_SDK_PLATFORM=win32
ARG QT_VERSION_MAJOR=5
ARG CMAKE_CMD=i686-w64-mingw32-cmake
ARG CORE_INSTALL_BASE=/opt/modbus-client
ARG BUILD_TYPE=Release

# 0) base-deps-win = Arch-based; unzip для fetch-core-sdk.sh (fallback есть)
RUN set -eux; \
    if command -v unzip >/dev/null 2>&1; then \
        echo "unzip: already available"; \
    elif command -v pacman >/dev/null 2>&1; then \
        pacman -Sy --noconfirm --needed unzip && echo "unzip: via pacman"; \
    fi

ENV CORE_SDK_PLATFORM=${CORE_SDK_PLATFORM} \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

# 1) Core SDK: win32 .zip
COPY scripts/fetch-core-sdk.sh /usr/local/bin/fetch-core-sdk.sh
RUN chmod +x /usr/local/bin/fetch-core-sdk.sh && \
    fetch-core-sdk.sh "${CORE_SDK_VERSION}" "${CORE_SDK_URL}" \
        "/opt/core/qt${QT_VERSION_MAJOR}/${CORE_SDK_VERSION}" \
        "${QT_VERSION_MAJOR}" && \
    ln -sfn "/opt/core/qt${QT_VERSION_MAJOR}/${CORE_SDK_VERSION}" \
            "/opt/core/qt${QT_VERSION_MAJOR}/latest" && \
    test -f "/opt/core/qt${QT_VERSION_MAJOR}/latest/lib/cmake/Core/CoreConfig.cmake" && \
    echo "=== Core SDK win32 / Qt${QT_VERSION_MAJOR} ready ==="

# 2) Сборка modbus-client (кросс, Qt5 mingw32)
WORKDIR /app
COPY . /app/modbus-client/
WORKDIR /app/modbus-client

# 2a) configure + build + install
RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    echo "=== modbus-client v${V} (Qt${QT_VERSION_MAJOR} win32) ==="; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    CORE_SDK="/opt/core/qt${QT_VERSION_MAJOR}/latest"; \
    mkdir -p "${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}"; \
    ${CMAKE_CMD} -S . -B build \
        -DCMAKE_BUILD_TYPE="${BUILD_TYPE}" \
        -DQT_VERSION_MAJOR="${QT_VERSION_MAJOR}" \
        -DCore_DIR="${CORE_SDK}/lib/cmake/Core" \
        -DCMAKE_INSTALL_PREFIX="${DEST}" \
        -DMODBUS_CLIENT_DEPLOY=OFF; \
    cmake --build build -j"$(nproc)"; \
    cmake --install build; \
    test -f "${DEST}/bin/modbus-client.exe" \
        || { echo "FATAL: modbus-client.exe missing" >&2; exit 1; }; \
    ln -sfn "${DEST}" "${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/latest"

# 2b) Core DLLs — только те, с которыми линкуется exe (4 файла)
RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    CORE_SDK="/opt/core/qt${QT_VERSION_MAJOR}/latest"; \
    mkdir -p "${DEST}/bin"; \
    for lib in libcore-lib libcore-journal-lib libcore-modbus-lib libcore-widgets-lib; do \
        cp -a "${CORE_SDK}/bin/${lib}.dll" "${DEST}/bin/"; \
    done

# 2c) Qt5 runtime DLLs
RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    cp -a /usr/i686-w64-mingw32/bin/Qt5*.dll          "${DEST}/bin/" 2>/dev/null || true; \
    cp -a /usr/i686-w64-mingw32/bin/libssl*.dll       "${DEST}/bin/" 2>/dev/null || true; \
    cp -a /usr/i686-w64-mingw32/bin/libcrypto*.dll    "${DEST}/bin/" 2>/dev/null || true; \
    cp -a /usr/i686-w64-mingw32/bin/libzstd*.dll      "${DEST}/bin/" 2>/dev/null || true

# 2d.1) Транзитивные зависимости Qt5 и Core: рекурсивный обход objdump -p.
#       libiconv-2 / libpcre2-16-0 / libharfbuzz-0 / libpng16-16 / zlib1
#       и т.п. — это зависимости Qt5Gui.dll / Qt5Core.dll, которые
#       не попадают в бандл при копировании только Qt5*.dll.
#       Берём всё, что реально требуется exe и уже скопированным DLL,
#       из sysroot i686-w64-mingw32 (только 32-бит, pei-i386).
RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    SYSROOT="/usr/i686-w64-mingw32"; \
    declare -A seen; \
    queue=("${DEST}/bin/modbus-client.exe"); \
    # Добавляем в очередь все уже скопированные DLL (Qt5, core, mingw runtime)
    for f in "${DEST}"/bin/*.dll; do [ -f "$f" ] && queue+=("$f"); done; \
    while [ ${#queue[@]} -gt 0 ]; do \
        f="${queue[0]}"; queue=("${queue[@]:1}"); \
        base="$(basename "$f")"; \
        [ -n "${seen[$base]:-}" ] && continue; \
        seen[$base]=1; \
        # Извлекаем имена DLL из PE-заголовка
        deps="$(i686-w64-mingw32-objdump -p "$f" 2>/dev/null | awk '/DLL Name:/{print $3}')"; \
        for dep in $deps; do \
            [ -n "${seen[$dep]:-}" ] && continue; \
            # Уже есть в бандле — просто добавляем в очередь для обхода
            if [ -f "${DEST}/bin/$dep" ]; then \
                queue+=("${DEST}/bin/$dep"); \
                continue; \
            fi; \
            # Ищем в sysroot MinGW
            src=""; \
            for cand in \
                "${SYSROOT}/bin/$dep" \
                "${SYSROOT}/lib/$dep" \
                "${SYSROOT}/lib/gcc/$dep"; do \
                if [ -f "$cand" ]; then src="$cand"; break; fi; \
            done; \
            if [ -z "$src" ]; then \
                # Системные DLL Windows (KERNEL32, USER32, …) — не наши, пропускаем
                case "$dep" in \
                    KERNEL32.dll|USER32.dll|GDI32.dll|ADVAPI32.dll|SHELL32.dll|ole32.dll|OLEAUT32.dll|WS2_32.dll|WINMM.dll|IMM32.dll|UxTheme.dll|dwmapi.dll|D3D11.dll|D3D9.dll|OPENGL32.dll|GLU32.dll|COMCTL32.dll|COMDLG32.dll|RPCRT4.dll|CRYPT32.dll|secur32.dll|bcrypt.dll|ncrypt.dll|IPHLPAPI.DLL|DNSAPI.dll|NETAPI32.dll|USERENV.dll|VERSION.dll|SHLWAPI.dll|MPR.dll|WINSPOOL.DRV|PSAPI.DLL|POWRPROF.dll|SETUPAPI.dll|CFGMGR32.dll|WTSAPI32.dll|MSVCRT.dll) \
                        continue ;; \
                esac; \
                echo "NOTE: $dep (required by $base) not found in sysroot — likely system DLL" >&2; \
                continue; \
            fi; \
            # Проверка разрядности перед копированием
            if ! i686-w64-mingw32-objdump -f "$src" 2>/dev/null | grep -q 'pei-i386'; then \
                echo "FATAL: $src is not 32-bit (pei-i386)" >&2; \
                i686-w64-mingw32-objdump -f "$src" >&2; \
                exit 1; \
            fi; \
            cp -a "$src" "${DEST}/bin/"; \
            echo "Dep (32-bit): $dep  <-  $src"; \
            queue+=("${DEST}/bin/$dep"); \
        done; \
    done; \
    echo "=== transitive deps collected: $(ls "${DEST}"/bin/*.dll | wc -l) DLLs ==="

# 2e) Qt5 plugins — рядом с exe, в {DEST}/bin/<category>/
#     (тот же баг, что и в win64-qt6: Qt ищет в <app_dir>/<category>/).
RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    for plugin_dir in platforms imageformats iconengines styles sqldrivers bearer; do \
        if [ -d "/usr/i686-w64-mingw32/lib/qt/plugins/${plugin_dir}" ]; then \
            cp -a "/usr/i686-w64-mingw32/lib/qt/plugins/${plugin_dir}" "${DEST}/bin/"; \
        fi; \
    done

# 2f) Финальная проверка layout
RUN set -eux; \
    V="$(tr -d '[:space:]' < VERSION)"; \
    DEST="${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/${V}"; \
    echo "=== install layout ==="; \
    find "${DEST}" -maxdepth 2 -type d | sort; \
    echo "--- bin/ (head) ---"; \
    ls "${DEST}/bin/" | head -30; \
    echo "--- plugins (next to exe) ---"; \
    for d in platforms imageformats iconengines styles sqldrivers bearer; do \
        [ -d "${DEST}/bin/$d" ] && echo "  bin/$d/"; \
    done; \
    for lib in libcore-lib libcore-journal-lib libcore-modbus-lib libcore-widgets-lib; do \
        test -f "${DEST}/bin/${lib}.dll" \
            || { echo "FATAL: ${lib}.dll missing" >&2; ls "${DEST}/bin/" >&2; exit 1; }; \
    done; \
    test -f "${DEST}/bin/Qt5Core.dll" \
        || { echo "FATAL: Qt5Core.dll missing" >&2; exit 1; }; \
    test -f "${DEST}/bin/platforms/qwindows.dll" \
        || { echo "FATAL: platforms/qwindows.dll missing in bin/" >&2; \
             ls "${DEST}/bin/platforms/" >&2 || true; exit 1; }; \
    for dll in libgcc_s_dw2-1.dll libstdc++-6.dll libwinpthread-1.dll; do \
        test -f "${DEST}/bin/$dll" \
            || { echo "FATAL: mandatory $dll missing in bundle" >&2; exit 1; }; \
    done; \
    echo "=== OK: modbus-client win-qt5 bundle ready ==="

# 3) Export
FROM scratch AS export
ARG QT_VERSION_MAJOR=5
ARG CORE_INSTALL_BASE=/opt/modbus-client
COPY --from=build ${CORE_INSTALL_BASE}/qt${QT_VERSION_MAJOR}/latest/ /

FROM build AS final